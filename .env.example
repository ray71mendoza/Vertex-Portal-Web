# Contact form email delivery (see src/lib/mailer.ts and src/app/api/contact/route.ts)
#
# Any SMTP provider works (Gmail with an App Password, a transactional provider like
# SendGrid/Mailgun/SES, or your hosting provider's SMTP). Never commit real values —
# copy this file to .env.local and fill it in there.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Optional: address emails are sent "from" (defaults to SMTP_USER if unset)
CONTACT_FROM_EMAIL=notificaciones@vertex.com

# Optional: where contact form submissions are delivered (defaults to gerenciavertexsas@gmail.com)
CONTACT_TO_EMAIL=gerenciavertexsas@gmail.com

# Base URL used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Must match the exact production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://vertex.com.co

# ---------------------------------------------------------------------------
# Analytics, attribution & marketing tracking (see docs/analytics-and-cookies.md)
#
# Every ID below is optional and independently gated by the Vertex cookie
# consent system (src/providers/ConsentProvider.tsx): leaving one unset simply
# skips that vendor entirely — never fake an ID to "complete" this file.
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID (Analytics consent required)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID (Analytics consent required)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# LinkedIn Insight Tag partner ID + optional conversion ID for the contact/lead
# event (Marketing consent required; never loaded on career/job-application pages)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONTACT_CONVERSION_ID=

# Google Ads conversion tracking: account ID + one conversion label per tracked
# business action (Marketing consent required; never loaded on career pages)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_JOB_APPLICATION_CONVERSION_LABEL=

# Meta Pixel ID (Marketing consent required; never loaded on career pages,
# approved event set only — no Advanced Matching, no form field values)
NEXT_PUBLIC_META_PIXEL_ID=

# Set to "true" to log consent/analytics routing decisions to the browser
# console in development. Never enable in production.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
