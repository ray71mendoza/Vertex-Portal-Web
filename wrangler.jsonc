{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vertex-portal-web",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vertex-portal-web"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "4739917e3ce247d68e33cffebf6e8f58"
    }
  ],

  "vars": {
    "CONTACT_FROM_EMAIL": "contact@mail.vertexcorp.com.co",
    "CONTACT_TO_EMAIL": "gerenciavertexsas@gmail.com"
  },

  "observability": {
    "enabled": true
  }
}